rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['admin', 'founder'];
    }
    
    function isVendor() {
      return isAuthenticated() && request.auth.token.role == 'vendor';
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isVendor() && request.auth.uid == vendorId);
    }
    
    match /candidates/{candidateId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.vendorId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAuthenticated() && (isAdmin() || resource.data.vendorId == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.vendorId == request.auth.uid);
    }
    
    match /requirements/{reqId} {
      allow read: if isAuthenticated(); 
      allow write: if isAdmin();
    }
    
    match /submissions/{subId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.vendorId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAuthenticated() && (isAdmin() || resource.data.vendorId == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.vendorId == request.auth.uid);
    }
    
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{document=**} {
      // Allow admin everything else
      allow read, write: if isAdmin();
    }
  }
}
